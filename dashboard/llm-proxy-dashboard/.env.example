# LLM Proxy Dashboard Configuration

# URL of the running llm-proxy instance
LLM_PROXY_URL=http://localhost:42604

# Path to the cost tracking JSONL file (written by the proxy's file transport)
LLM_PROXY_COST_FILE=/home/appmotel/.local/share/appmotel/proxyisaac2/repo/logs/cost-tracking.jsonl

# Dashboard port (default: 5001, overridden by appmotel)
PORT=5001

# Optional: Restrict dashboard access to specific CIDR ranges (comma-separated)
# SUBNETS_ONLY=192.168.0.0/16,10.0.0.0/8
