# LLM Proxy Configuration
# Copy this file to .env and update values as needed

# Server Configuration
ENVIRONMENT=dev
PORT=9002
LOG_LEVEL=debug
LOG_FORMAT=pretty  # or "json" for production

# Existing LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# AWS Bedrock Configuration
# AWS credentials are read from:
# 1. AWS_PROFILE env var (if set)
# 2. [bedrock] profile in ~/.aws/credentials (default)
# 3. [default] profile in ~/.aws/credentials (fallback)
AWS_PROFILE=bedrock
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
BEDROCK_ENABLED=true

# Local LLM Endpoints
# GPT-OSS Provider (OpenAI/GPT-OSS 120B model)
GPT_OSS_ENDPOINT_1=http://192.168.1.100:8000/v1
GPT_OSS_ENDPOINT_2=http://192.168.1.101:8000/v1
GPT_OSS_API_KEY=  # Optional - leave empty if not required

# Qwen Provider (Qwen3 Next 80B A3B Thinking model)
QWEN_ENDPOINT_1=http://192.168.1.200:8001/v1
QWEN_ENDPOINT_2=http://192.168.1.201:8001/v1
QWEN_API_KEY=  # Optional - leave empty if not required

# Local LLM Configuration
LOCAL_LLM_TIMEOUT=120  # seconds
LOCAL_LLM_RETRY_COUNT=3

# Debug Configuration
DEBUG_MODE_ENABLED=false  # Can be overridden by --llm-debug flag
DEBUG_REQUEST_COLOR=cyan
DEBUG_RESPONSE_COLOR=green
DEBUG_OUTPUT_FORMAT=pretty  # "pretty", "json", or "compact"

# Cost Tracking (existing feature)
COST_TRACKING_FILE=logs/cost-tracking.jsonl

# Features
RATE_LIMITING_ENABLED=false
API_KEY_MANAGEMENT_ENABLED=false
